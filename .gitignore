# ── Secretos y entorno (regla 12: ningún secreto en el repo) ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Python / backend ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/

# ── Node / frontend ──
node_modules/
dist/
dist-ssr/
*.local
